# Required: long random string (32+ characters) that encrypts the session cookie.
SESSION_SECRET=
# E-mail sign-in codes are sent with Resend (https://resend.com).
RESEND_API_KEY=
RESEND_FROM="Vita Nova Life <login@vitanovalife.com>"
# Local development only, never set in production: print the code in the server log
# and show it on the sign-in page instead of sending an e-mail.
# AUTH_DEV_CODE=1
